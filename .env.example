POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=medivault
MEDIVAULT_ENC_KEY=CHANGE_ME
PGADMIN_EMAIL=admin@medivault.lu
PGADMIN_PASSWORD=CHANGE_ME
# IP address allowed to connect via TCP (pg_hba.conf rule [4]).
# Set to 127.0.0.1 for local dev, or the trusted client's IP for a remote setup.
TRUSTED_IP=127.0.0.1
# Application user passwords — populated by: node scripts/generate-passwords.js
PW_DR_HOUSE=CHANGE_ME
PW_DR_WILSON=CHANGE_ME
PW_NURSE_JOY=CHANGE_ME
PW_RECEP_PAM=CHANGE_ME
PW_PAT_ALICE=CHANGE_ME
PW_PAT_BOB=CHANGE_ME
PW_SVC_BILLING=CHANGE_ME
PW_AUD_SMITH=CHANGE_ME
PW_ADM_ROOT=CHANGE_ME
# --- Backups (pgBackRest -> Garage). Intervals in minutes; test values, raise for real use.
BACKUP_FULL_INTERVAL_MIN=15
BACKUP_INCR_INTERVAL_MIN=5
BACKUP_RETENTION_FULL=4
# --- Logs: new log file every N minutes (shorter = smaller tamper window, more files);
#     local copies already shipped to Garage are deleted after LOG_KEEP_DAYS
LOG_ROTATION_MIN=1
LOG_KEEP_DAYS=7
BACKUP_BUCKET=medivault-backups
AUDIT_BUCKET=medivault-audit
BACKUP_ENC_KEY=CHANGE_ME
# --- Garage (S3). GARAGE_KEY_SECRET = sha256(POSTGRES_PASSWORD) for S3 user "postgres"
GARAGE_RPC_SECRET=CHANGE_ME
GARAGE_ADMIN_TOKEN=CHANGE_ME
GARAGE_KEY_ID=CHANGE_ME
GARAGE_KEY_SECRET=CHANGE_ME
AUDIT_KEY_ID=CHANGE_ME
AUDIT_KEY_SECRET=CHANGE_ME
